# Copy to /etc/comfy-mcp.env and edit. Do not commit the filled-in file.
# Suggested mode: 0640, owner root, group comfy (the service user).
#
# This file is read by both systemd units. comfy-mcp does not listen on a
# port; Supergateway inherits this environment and passes it to the stdio
# child. The upload server reads the COMFY_MCP_UPLOAD_* variables itself.

# Absolute comfy-cli binary. It is NOT an entry point of the comfy-mcp
# package. Install comfy-cli into the same virtualenv (see the deployment guide).
COMFY_BIN=/opt/comfy-mcp/bin/comfy

# comfy-cli's own local-server override. The child inherits it and uses it to
# reach ComfyUI. This server also reads it to recognize that origin when a
# generated /view?type=output URL is returned to an MCP client. It does not
# forward the variable as --host/--port. Do not set COMFYUI_URL for a ComfyUI
# on this machine: that knob selects a remote target.
COMFY_LOCAL_URL=http://127.0.0.1:8189

# Externally reachable base for generated-output URLs returned to MCP clients.
# Not the ComfyUI connection URL. A local /view?type=output link is rewritten
# onto this origin. type=input and type=temp are not. The proxy must allow
# GET and HEAD of /view?...&type=output and keep input, temp, and the UI closed.
# Any public name is fine. A Tailscale Funnel name is only one example.
# An optional path prefix is joined in front of /view.
COMFY_MCP_PUBLIC_BASE_URL=https://YOUR_HOSTNAME.example

# Shared spool. Temporary ingress only, not ComfyUI's input directory.
COMFY_MCP_UPLOAD_DIR=/var/lib/comfy-mcp/uploads

# Optional upload-specific origin. No path, query, userinfo, or fragment.
# When unset, init_upload uses COMFY_MCP_PUBLIC_BASE_URL. Set this only when
# uploads are published on a different origin from generated outputs.
# COMFY_MCP_UPLOAD_PUBLIC_BASE_URL=https://YOUR_HOSTNAME.example

# Session lifetime in seconds. Values outside 30..86400 are clamped.
COMFY_MCP_UPLOAD_TTL_SECONDS=600

# Maximum original-byte size, in megabytes. Default 1024. Ceiling 8192.
COMFY_MCP_MAX_UPLOAD_MB=1024

# Loopback only. Any other host is refused at startup.
COMFY_MCP_UPLOAD_HOST=127.0.0.1
COMFY_MCP_UPLOAD_PORT=8192

# Opt-in failure log. Unset, empty, or 0 disables it. A path enables it.
COMFY_MCP_DEBUG_LOG=/var/log/comfy-mcp/failures.jsonl

# Optional. When the deploy has no git checkout, set the same hex SHA in this
# file so both processes log the same build. Do not invent a value.
# COMFY_MCP_GIT_SHA=
